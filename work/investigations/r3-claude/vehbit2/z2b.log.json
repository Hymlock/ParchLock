 },
 {
  "cmd": "N",
  "tag": null,
  "parentBefore": 100,
  "parentBeforeName": "Tiny Room",
  "parentAfter": 103,
  "parentAfterName": "Dreary Room",
  "playerId": 4,
  "reply": "Dreary Room\nThis is a small and rather dreary room, eerily illuminated by a red glow emanating from a crack in one wall. The light falls upon a dusty wooden table in the center of the room. On the south side of the room is a massive wooden door, which has a small window barred with iron. A formidable bolt lock is set within the door frame. A keyhole lies within the lock.\nIn the center of the table sits a blue crystal sphere.\n \n>"
 },
 {
  "cmd": "GET BLUE SPHERE",
  "tag": null,
  "parentBefore": 103,
  "parentBeforeName": "Dreary Room",
  "parentAfter": 103,
  "parentAfterName": "Dreary Room",
  "playerId": 4,
  "reply": "Taken.\n \n>"
 },
 {
  "cmd": "S",
  "tag": null,
  "parentBefore": 103,
  "parentBeforeName": "Dreary Room",
  "parentAfter": 100,
  "parentAfterName": "Tiny Room",
  "playerId": 4,
  "reply": "Tiny Room\nThere is a rusty iron key here.\nThere is a place mat here.\nThere is a letter opener here.\n \n>"
 },
 {
  "cmd": "D",
  "tag": null,
  "parentBefore": 100,
  "parentBeforeName": "Tiny Room",
  "parentAfter": 213,
  "parentAfterName": "Ledge in Ravine",
  "playerId": 4,
  "reply": "Ledge in Ravine\n \n>"
 },
 {
  "cmd": "W",
  "tag": null,
  "parentBefore": 213,
  "parentBeforeName": "Ledge in Ravine",
  "parentAfter": 212,
  "parentAfterName": "End of Ledge",
  "playerId": 4,
  "reply": "End of Ledge\nA ledge from the east ends here, and a tunnel leads north into the wall. There is a rather odd smokey odor in the warm air of the tunnel.\nYour sword is glowing with a faint blue glow.\n \n>"
 },
 {
  "cmd": "N",
  "tag": null,
  "parentBefore": 212,
  "parentBeforeName": "End of Ledge",
  "parentAfter": 211,
  "parentAfterName": "Dragon Room",
  "playerId": 4,
  "reply": "Dragon Room\nThe room is a large cavern full of broken stone. The walls are scorched and there are deep scratches on the floor. A sooty dry smell is very strong here. A paved path winds from a large passage to the west, through the room, and across a huge stone bridge to the south. To the east a small crack is visible. A dark and smokey tunnel leads north.\nA huge red dragon is lying here, blocking the entrance to a tunnel leading north. Smoke curls from his nostrils and out between his teeth.\nYour sword has begun to glow very brightly.\n \n>"
 },
 {
  "cmd": "HIT DRAGON WITH SWORD",
  "tag": null,
  "parentBefore": 211,
  "parentBeforeName": "Dragon Room",
  "parentAfter": 211,
  "parentAfterName": "Dragon Room",
  "playerId": 4,
  "reply": "You've made him rather angry. You had better be very careful now.\nThe dragon continues to watch you carefully.\n \n>"
 },
 {
  "cmd": "S",
  "tag": null,
  "parentBefore": 211,
  "parentBeforeName": "Dragon Room",
  "parentAfter": 202,
  "parentAfterName": "Stone Bridge",
  "playerId": 4,
  "reply": "Stone Bridge\nThis is the middle of a ruined but still impressive stone bridge spanning a deep chasm. Water flows far beneath. A paved path leads north into a large open space. To the south, the path leads into a misty tunnel.\nThe dragon follows you, out of mingled curiosity and anger.\n \n>"
 },
 {
  "cmd": "HIT DRAGON WITH SWORD",
  "tag": null,
  "parentBefore": 202,
  "parentBeforeName": "Stone Bridge",
  "parentAfter": 202,
  "parentAfterName": "Stone Bridge",
  "playerId": 4,
  "reply": "The dragon is surprised and interested (for the moment).\nThe dragon continues to watch you carefully.\n \n>"
 },
 {
  "cmd": "S",
  "tag": null,
  "parentBefore": 202,
  "parentBeforeName": "Stone Bridge",
  "parentAfter": 201,
  "parentAfterName": "Cool Room",
  "playerId": 4,
  "reply": "The room is cool and damp. The air is misty. A twisty path from the southeast splits here toward a wide northerly stone bridge, and a narrow westerly tunnel. It is from the latter that the mist and chill seem to originate.\nThe dragon follows you, out of mingled curiosity and anger.\n \n>"
 },
