          "\t\t\t\t    <GET .RMG <+ <* .CNT 2> 1>>>",
          "\t\t\t      <SET FOO",
          "\t\t\t\t   <BACK <GETPT ,PSEUDO-OBJECT ,P?ACTION> 5>>",
          "\t\t\t      <PUT .FOO 0 <GET ,P-NAM 0>>",
          "\t\t\t      <PUT .FOO 1 <GET ,P-NAM 1>>",
          "\t\t\t      <OBJ-FOUND ,PSEUDO-OBJECT .TBL>",
          "\t\t\t      <RETURN>)",
          "\t\t             (<IGRTR? CNT .RMGL> <RETURN>)>>)>",
          "\t<COND (<EQUAL? <GET .TBL ,P-MATCHLEN> .LEN>",
          "\t       <SETG P-SLOCBITS -1>",
