+check('other titles: only the three first-batch digests carry wearForms (LH ring, Starcross junk 176 stay out)',()=>{
+  const c=vm.createContext({});vm.runInContext(fs.readFileSync('js/ModuleStatFactsClaude.js','utf8'),c);
