(async () => {
  const vm = window.__PARCHLOCK_EAMON__, sleep = ms => new Promise(r => setTimeout(r, ms));
  const text = () => (document.querySelector('#windowport .BufferWindow') || {innerText: ''}).innerText.replace(/\u00a0/g, ' ');
  const tailLine = () => { const t = text().replace(/\s+$/, ''); return t.slice(t.lastIndexOf('\n') + 1); };
  const send = v => { const ch = document.querySelector('#windowport .Input.CharInput'); if (ch) jQuery('.Input.CharInput').trigger(jQuery.Event('keypress', {which: v.codePointAt(0)})); else { Input.Clear(); Input.Inject(v, true); } };
  const queue = SELECTIONS; let q = 0; const log = []; const started = Date.now();
  const checks = () => (vm.state.saves || []).filter(e => /^contract-check/.test(e));
  while (Date.now() - started < 240000 && !checks().length) {
    await sleep(600);
    try { if (Message.IsOpen) Message.Hide(); } catch (e) {}
    const tl = tailLine(); let v = null;
    if (/D for desk/.test(tl)) v = 'D';
    else if (/type it in now/.test(tl)) v = 'Parch Tester';
    else if (/Enter the selection/.test(tl)) v = String(queue[q++] || 'X');
    else if (/\[X\]:$/.test(tl)) v = '1';
    else if (/introduction story|see the intro/i.test(tl)) v = 'N';
    else if (/\(Y\/N\)|Y for yes/i.test(tl)) v = 'Y';
    else if (/Press any key/i.test(tl)) v = ' ';
    else if (tl.trim() === '>') v = 'look';
    if (v != null) { log.push(tl.slice(-40) + ' => ' + v); send(v); }
  }
  return { checks: checks(), log: log.slice(-12) };
})()
