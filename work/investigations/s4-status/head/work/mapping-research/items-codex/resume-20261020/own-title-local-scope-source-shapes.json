          "\t\t       <COND (<FIRST? .OBJ>",
          "\t\t\t      <SEARCH-LIST .OBJ .TBL ,P-SRCALL>)>",
          "\t\t       <COND (<THIS-IT? .OBJ>",
          "\t\t\t      <OBJ-FOUND .OBJ .TBL>)>",
