  "parentBeforeName": "Your Tent",
  "parentAfter": 71,
  "parentAfterName": "Your Tent",
  "playerId": 223,
  "reply": "Opened. Opening the trunk reveals an inspection sticker, a piece of dried beef, and an ancient map.\n \n>"
 },
 {
  "cmd": "get beef",
  "tag": null,
  "parentBefore": 71,
  "parentBeforeName": "Your Tent",
  "parentAfter": 71,
  "parentAfterName": "Your Tent",
  "playerId": 223,
  "reply": "Taken.\n \n>"
 },
 {
  "cmd": "get map",
  "tag": null,
  "parentBefore": 71,
  "parentBeforeName": "Your Tent",
  "parentAfter": 71,
  "parentAfterName": "Your Tent",
  "playerId": 223,
  "reply": "Taken. It feels fairly heavy, though, as though it were folded around something solid.\n \n>"
 },
 {
  "cmd": "eat beef",
  "tag": null,
  "parentBefore": 71,
  "parentBeforeName": "Your Tent",
  "parentAfter": 71,
  "parentAfterName": "Your Tent",
  "playerId": 223,
  "reply": "That really hit the spot. It did make you a little thirstier, though.\n \n>"
 },
 {
  "cmd": "s",
  "tag": null,
  "parentBefore": 71,
  "parentBeforeName": "Your Tent",
  "parentAfter": 72,
