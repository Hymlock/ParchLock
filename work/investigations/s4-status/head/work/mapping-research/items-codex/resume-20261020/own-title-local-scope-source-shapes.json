          "\t       <DO-SL ,GLOBAL-OBJECTS 1 1>",
          "\t       <SETG P-SLOCBITS .OBITS>",
          "\t       <COND (<ZERO? <GET .TBL ,P-MATCHLEN>>",
          "\t\t      <COND (<VERB? EXAMINE DUMB-EXAMINE LOOK-INSIDE FIND",
