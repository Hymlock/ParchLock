 },
 {
  "cmd": "W",
  "tag": null,
  "parentBefore": 17,
  "parentBeforeName": "Your Quarters",
  "parentAfter": 67,
  "parentAfterName": "Hallway",
  "playerId": 223,
  "reply": "Hallway\nRooms lie to the east and west from this north-south corridor. A heavy wooden door, currently closed, leads north.\nTacked to the doorframe of your room is a note, hurriedly scribbled on parchment.\n \n>"
 },
 {
  "cmd": "READ NOTE",
  "tag": null,
  "parentBefore": 67,
  "parentBeforeName": "Hallway",
  "parentAfter": 67,
  "parentAfterName": "Hallway",
  "playerId": 223,
  "reply": "(taking the scribbled note first)\n\"I have taken the apprentices into town to shop for the Guild picnic. I tried rousing you, but you seemed deep asleep. By the way, have you seen Belboz anywhere? It's not like him to leave without telling someone -- but then, he's been acting pretty odd of late.\n \n                            -- Frobar\"\n \n>"
 },
 {
  "cmd": "DROP IT",
  "tag": null,
  "parentBefore": 67,
  "parentBeforeName": "Hallway",
  "parentAfter": 67,
  "parentAfterName": "Hallway",
  "playerId": 223,
  "reply": "Dropped.\n \n>"
 },
 {
  "cmd": "W",
  "tag": null,
  "parentBefore": 67,
  "parentBeforeName": "Hallway",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "Belboz's Quarters\nThe personal chamber of Belboz, who presides over the Circle of Enchanters, is appointed with a beautiful woven wall hanging, an exotic morgia plant, and a wide darkwood desk crafted by the artisans of Gurth. The hallway lies to the east.\nPacing back and forth on a perch in the corner is Belboz's prized pet parrot, native to the jungles of Miznia.\n \n\"Squawk! Belboz, the Circle is waiting for you. Squawk!\"\n \n>"
 },
 {
  "cmd": "OPEN DESK",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "Opening the desk drawer reveals a tiny box, an infotater, and a journal.\n \n>"
 },
 {
  "cmd": "GET BOX AND JOURNAL",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "tiny box: Taken.\njournal: Taken.\n \nYou are now a bit thirsty.\n \n>"
 },
 {
  "cmd": "LOOK BEHIND TAPESTRY",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "As you move the tapestry, a key falls out from behind it and lands on the floor.\n \n>"
 },
 {
  "cmd": "GET KEY",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "Taken.\n \n\"Squawk! You should never have let down your mindshield, you doddering old Enchanter. Squawk!\"\n \n>"
 },
 {
  "cmd": "OPEN JOURNAL",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "(with the key)\nThe journal springs open.\n \nYou are now a bit hungry.\n \n>"
 },
 {
  "cmd": "READ IT",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "You skim through the pages of the journal, a combination diary and notebook. Most of the notations, written in Belboz's familiar flowing script, deal with meetings of the Circle and business of the Guild.\n \nThere is one interesting entry toward the end of the book. Belboz refers to an ancient and evil force known simply as Jeearr, a demon whose powers could endanger the Circle and possibly the entire kingdom. He has decided to conduct some dangerous exploratory experiments, operating alone to shield the Circle from the perils involved.\n \nThe last three entries are strange and frightening -- written in a hand quite different from that of Belboz, and in a language totally unfamiliar to you.\n \n"
 },
 {
  "cmd": "DROP JOURNAL AND KEY",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 115,
  "parentAfterName": "Belboz's Quarters",
  "playerId": 223,
  "reply": "journal: Dropped.\nsmall key: Dropped.\n \n>"
 },
 {
  "cmd": "E",
  "tag": null,
  "parentBefore": 115,
  "parentBeforeName": "Belboz's Quarters",
  "parentAfter": 67,
  "parentAfterName": "Hallway",
  "playerId": 223,
  "reply": "Hallway\nThere is a scribbled note here.\n \n>"
 },
 {
  "cmd": "S",
  "tag": null,
  "parentBefore": 67,
  "parentBeforeName": "Hallway",
  "parentAfter": 50,
  "parentAfterName": "Hallway",
  "playerId": 223,
  "reply": "Hallway\nRooms lie to the east and west from this north-south corridor. A large marble archway to the south leads into an open area.\n \nThe Guild Hall doorbell chimes.\n \n>"
 },
 {
  "cmd": "S",
  "tag": null,
  "parentBefore": 50,
  "parentBeforeName": "Hallway",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "Lobby\nThis is the entrance lobby of the Guild Hall. Befitting the status and wealth of the Guild, the lobby is finished with polished Antharian marble, inlaid with intricate patterns of silver leaf. To the north is a wide arch, and smaller openings flank the area on the eastern and western sides, as well as the northeastern and northwestern corners. A narrow stair leads downward. Through another arch to the south, you can see the entrance steps and the main road into town.\nAffixed to the southern arch is an ornate brass receptacle, intended for use by messengers.\n \n>"
 },
 {
  "cmd": "W",
  "tag": null,
  "parentBefore": 18,
  "parentBeforeName": "Lobby",
  "parentAfter": 231,
  "parentAfterName": "Store Room",
  "playerId": 223,
  "reply": "Store Room\nThis is a closet for storage. The only exit is east.\nAmong the provisions here is a small ochre-colored vial, closed and labelled with tiny lettering.\nThere is a calendar here (providing light).\nThere is a depleted matchbook here.\n \nYou are now somewhat thirsty.\n \n>"
 },
 {
  "cmd": "GET VIAL, CALENDAR AND MATCHBOOK",
  "tag": null,
  "parentBefore": 231,
  "parentBeforeName": "Store Room",
  "parentAfter": 231,
  "parentAfterName": "Store Room",
  "playerId": 223,
  "reply": "ochre vial: Taken.\ncalendar: Taken.\ndepleted matchbook: Taken.\n \n>"
 },
 {
  "cmd": "E",
  "tag": null,
  "parentBefore": 231,
  "parentBeforeName": "Store Room",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "Lobby\nAffixed to the southern arch is an ornate brass receptacle, intended for use by messengers.\n \n>"
 },
 {
  "cmd": "OPEN RECEPTACLE",
  "tag": null,
  "parentBefore": 18,
  "parentBeforeName": "Lobby",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "Opening the receptacle reveals an issue of Popular Enchanting.\n \n>"
 },
 {
  "cmd": "READ MATCHBOOK",
  "tag": null,
  "parentBefore": 18,
  "parentBeforeName": "Lobby",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "\"Amazing Vilstu Potion!\n \nGet by without breathing! Amaze your\nfriends! Be the first person on the\nblock to own some!\n \nOrder today by dropping this in any\nmailbox. Our shipping department will\nuse the latest in temporal travel\ntechniques to insure that your potion\narrives the same day you order it!\n(Orders received before noon will\narrive the day before you order).\"\n \n>"
 },
 {
  "cmd": "PUT IT IN RECEPTACLE",
  "tag": null,
  "parentBefore": 18,
  "parentBeforeName": "Lobby",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "Done.\n \nYou are now somewhat hungry.\n \n>"
 },
 {
  "cmd": "E",
  "tag": null,
  "parentBefore": 18,
  "parentBeforeName": "Lobby",
  "parentAfter": 142,
  "parentAfterName": "Library",
  "playerId": 223,
  "reply": "Library\nThis is a study chamber for members of the Guild. Usually, there would be several elder Enchanters patiently training novices, but no one is here at the moment. The only exit is west.\nLying open on a stand in one corner is a heavy volume, probably a copy of the Encyclopedia Frobizzica.\nThe servants have been lax lately, for a scroll is lying among the dust in the corner.\n \n>"
 },
 {
  "cmd": "GET SCROLL",
  "tag": null,
  "parentBefore": 142,
  "parentBeforeName": "Library",
  "parentAfter": 142,
  "parentAfterName": "Library",
  "playerId": 223,
  "reply": "Taken.\n \n>"
 },
 {
  "cmd": "READ IT",
  "tag": null,
  "parentBefore": 142,
  "parentBeforeName": "Library",
  "parentAfter": 142,
  "parentAfterName": "Library",
  "playerId": 223,
  "reply": "The scroll reads \"meef spell: cause plants to wilt\".\n \n>"
 },
 {
  "cmd": "GNUSTO MEEF SPELL",
  "tag": null,
  "parentBefore": 142,
  "parentBeforeName": "Library",
  "parentAfter": 142,
  "parentAfterName": "Library",
  "playerId": 223,
  "reply": "Your spell book begins to glow softly. Slowly, ornately, the words of the meef spell are inscribed, glowing even more brightly than the book itself. The book's brightness fades, but the spell remains! However, the scroll on which it was written vanishes as the last word is copied.\n \nYou are now quite thirsty.\n \n>"
 },
 {
  "cmd": "W",
  "tag": null,
  "parentBefore": 142,
  "parentBeforeName": "Library",
  "parentAfter": 18,
  "parentAfterName": "Lobby",
  "playerId": 223,
  "reply": "Lobby\nAffixed to the southern arch is an ornate brass receptacle, intended for use by messengers.\nThe receptacle contains:\n  a depleted matchbook\n  an issue of Popular Enchanting\n \n>"
 },
