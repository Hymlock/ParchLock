inal is a hacker whom you recognize.\n \n> \n➤\n🎤\nThe Lurking Horror\nAn Interactive Horror\nBy Infocom\nMap controls\nCenter\n-\n100%\n+\nMaps\nReset Map\n1 rooms / 2 exits / 0 notes\nIN\nUP\nNW\nN\nNE\nW\nTerminal Room\nE\nSW\nS\nSE\nDOWN\nOUT\nKNOWN ROOMS\nTerminal Room\nNotes\nParchLock! build 72\nMenu","steps":[],"final":{"count":252,"o":{"1":{"n":"catwalk","p":213,"c":0,"o":0,"a":0},"2":{"n":"keyring","p":129,"c":1,"o":1,"a":0},"3":{"n":"red aluminum Yale key","p":2,"c":0,"o":0,"a":0},"4":{"n":"air","p":82,"c":0,"o":0,"a":0},"5":{"n":"elevator shaft","p":0,"c":1,"o":1,"a":0},"6":{"n":"your hand","p":82,"c":0,"o":0,"a":0},"7":{"n":"smooth stone","p":21,"c":1,"o":1,"a":0},"8":{"n":"plastic container","p":218,"c":1,"o":0,"a":0},"9":{"n":"Tomb","p":49,"c":0,"o":0,"a":0},"10":{"n":"cylindrical hole","p":0,"c":1,"o":1,"a":0},"11":{"n":"passage","p":82,"c":0,"o":0,"a":0},"12":{"n":"wooden ladder","p":213,"c":0,"o":0,"a":0},"13":{"n":"program","p":59,"c":0,"o":0,"a":0},"14":{"n":"metal cover","p":192,"c":0,"o":0,"a":0},"15":{"n":"Wet Tunnel","p":49,"c":0,"o":0,"a":0},"16":{"n":"Small Courtyard","p":49,"c":0,"o":0,"a":0},"17":{"n":"Cinderblock Tunnel","p":49,"c":0,"o":0,"a":0},"18":{"n":"package of Funny Bones","p":160,"c":0,"o":0,"a":0},"19":{"n":"brick wall","p":138,"c":1,"o":1,"a":0},"20":{"n":"maintenance man","p":235,"c":0,"o":0,"a":0},"21":{"n":"At Platform","p":49,"c":0,"o":0,"a":0},"22":{"n":"slime curtain","p":181,"c":0,"o":0,"a":0},"23":{"n":"vat","p":212,"c":1,"o":1,"a":0},"24":{"n":"your feet","p":82,"c":0,"o":0,"a":0},"25":{"n":"Brick Tunnel","p":49,"c":0,"o":0,"a":0},"26":{"n":"iron plate","p":149,"c":1,"o":0,"a":0},"27":{"n":"Basement","p":49,"c":0,"o":0,"a":0},"28":{"n":"wall socket","p":210,"c":0,"o":0,"a":0},"29":{"n":"yourself","p":82,"c":0,"o":0,"a":0},"30":{"n":"branded symbol","p":96,"c":0,"o":0,"a":0},"31":{"n":"manhole","p":171,"c":1,"o":1,"a":1},"32":{"n":"hook","p":153,"c":0,"o":0,"a":0},"33":{"n":"Kitchen","p":49,"c":0,"o":0,"a":0},"34":{"n"