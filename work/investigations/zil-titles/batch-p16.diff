--- /dev/null
+++ b/work/investigations/claude-probe/p16-enchanter/probe.cjs
@@ -0,0 +1,27 @@
+// D16 P16 native label-tier probe (seeded: default play.html boot, no forced seed). Enchanter: i, read book.
+// Records native reply, native object tree under the player, app payload inventory (with labelSuppressed),
+// EquipmentUI drawn rows, RenderInventory text, live underline marks on the reply, and the commands a spell link yields.
+//   node work/investigations/claude-probe/p16-enchanter/probe.cjs   (from the repo root)
+const fs=require('fs'),path=require('path'),{pathToFileURL}=require('url'),{chromium}=require(process.cwd()+'/node_modules/playwright');
+const OUTDIR='work/investigations/claude-probe/p16-enchanter';
+(async()=>{const b=await chromium.launch();const p=await (await b.newContext()).newPage();
+await p.addInitScript(()=>{sessionStorage.setItem('PL_ParchLockSplashSeen','1');for(const k of ['PL_TutorialSeen','PL_MobileTutorialSeen','PL_LearnedWordsTutorialSeen','PL_TutorialLibrarySeen'])localStorage.setItem(k,'1')});
+await p.goto(pathToFileURL(path.resolve('play.html')).href+'?story=games/Enchanter.z3.js');await p.waitForTimeout(3400);
+if(await p.locator('#message.show #close').isVisible())await p.locator('#message.show #close').click();
+async function ready(){for(let i=0;i<20;i++){if(await p.locator('.Input.LineInput:visible').count())return;if(await p.locator('.Input.CharInput:visible').count())await p.keyboard.press('Enter');await p.waitForTimeout(150)}throw Error('no input')}
+const log=[];
+for(const c of ['i','read book']){await ready();await p.locator('.Input.LineInput:visible').first().fill(c);await p.keyboard.press('Enter');await p.waitForTimeout(700);await ready();
+const r=await p.evaluate(()=>{const ls=[...document.querySelectorAll('#windowport .BufferLine')];let k=-1;for(let i=ls.length-1;i>=0;i--)if(ls[i].querySelector('.Style_input')){k=i;break}
+const lines=ls.slice(k);const q=WorldModel.lastPayload||WorldModel.tick(),m=ZRamProvider.getMem(),R=ZRamReader;const pl=Number((q.probe&&q.probe.inventoryRootId)||q.playerId);const tree=[];
+const walk=(id,d)=>{for(let c=R.objectLinks(m,id).child;c;c=R.objectLinks(m,c).sibling){const o=R.objectLinks(m,c);tree.push(' '.repeat(d)+c+':'+R.shortName(m,c)+' ['+Array.from({length:32},(_,i)=>i).filter(i=>R.attr(o,i))+']');if(d<4)walk(c,d+1)}};walk(pl,0);
+const marks=lines.flatMap(l=>[...l.querySelectorAll('[data-object-id]')]).map(x=>({text:x.textContent,objectId:x.dataset.objectId}));
+const inv=(q.inventory||[]);const spells=inv.filter(o=>o.labelSuppressed);
+const em=EquipmentUI.model();
+const cmds={};inv.filter(o=>String(o.parentId)!==String(pl)).forEach(o=>{cmds[o.id+':'+o.name]=(ActionSynth.commandsForPayloadObjectId(o.id)||[]).map(c=>typeof c==='string'?c:(c.command||c.text||JSON.stringify(c)))});
+const pool=Actionable.payloadPool().map(o=>o.id);
+Actionable.RenderInventory();const rendered=(document.querySelector('#items-tab')||{}).innerText||'';
+return{reply:lines.map(x=>x.textContent).join('\n'),player:pl,nativeTree:tree,appInventory:inv.map(o=>({id:o.id,name:o.name,parentId:o.parentId,labelSuppressed:!!o.labelSuppressed})),
+equipmentDrawn:em.items.map(o=>o.id+':'+o.name),equipmentTopLevel:em.topLevel.map(o=>o.id+':'+o.name),categoryCounts:EquipmentUI.categoryCounts(em),demo:!!em.demo,
+renderInventoryText:rendered.slice(0,400),poolHasSpells:spells.map(o=>[o.id,pool.some(x=>String(x)===String(o.id))]),replyMarks:marks,spellCommands:cmds}});log.push({cmd:c,...r})}
+fs.writeFileSync(OUTDIR+'/run-enchanter.json',JSON.stringify({tier:'seeded-native (play.html default boot, label tier; not a fresh unforced device run)',date:new Date().toISOString(),log},null,1));
+console.log(JSON.stringify(log,null,1));await b.close()})().catch(e=>{console.error(e);process.exit(1)});
