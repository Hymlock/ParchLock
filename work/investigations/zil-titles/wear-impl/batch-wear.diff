+  assert.deepStrictEqual(with_.sort(),TITLES.map(t=>t.digest).sort());
+  assert(!rows[TITLES[2].digest].wearForms.objects.includes(176));});
+console.log(n+' identity-wear checks passed; native evidence is separate.');
